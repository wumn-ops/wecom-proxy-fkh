# wecom-proxy-fkh — 独立实例，与 wecom-proxy 并行部署
# 须使用独立 Token/EncodingAESKey、独立端口、独立 PUBLIC_BASE_URL

# 企业微信智能机器人 API 模式凭证（管理后台 -> 智能机器人 -> 编辑 -> API 设置）
WECOM_TOKEN=your_token
WECOM_ENCODING_AES_KEY=your_43_char_encoding_aes_key

HOST=0.0.0.0
PORT=8002
WECOM_CALLBACK_PATH=/wecom/aibot/callback/fkh-api
HEALTH_PATH=/health/fkh-api
LOG_LEVEL=INFO

# 智能表格「接收外部数据」Webhook（101239，勿提交到 Git）
# 字段 ID 在智能表格 Webhook 配置页查看，与 CRM 绑定表列一一对应
SMARTSHEET_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/wedoc/smartsheet/webhook?key=YOUR_KEY
# fZtG8O=处理类型(绑定/解绑) ftQMc5=绑定状态(提交默认「未审核」) f04Gwj=货号 fVFFek=客户名称 ftk5Tx=提交人
SMARTSHEET_FIELD_PROCESS_TYPE=fZtG8O
SMARTSHEET_FIELD_BIND_STATUS=ftQMc5
CRM_BIND_REVIEW_STATUS=未审核
# CRM_BIND_SUCCESS_MESSAGE=您提交的需求工艺已收到，您将在工艺处理完成后得到反馈。
SMARTSHEET_FIELD_PRODUCT_CODE=f04Gwj
SMARTSHEET_FIELD_CUSTOMER_NAME=fVFFek
SMARTSHEET_FIELD_SUBMITTER=ftk5Tx

# H5 公网地址（与 Nginx 外网域名一致，路径带 /fkh-api 后缀）
PUBLIC_BASE_URL=https://wecom.vazyme.com:8021
CRM_BIND_PATH=/crm/bind/fkh-api
REGISTER_UPLOAD_PATH=/register/upload/fkh-api
UPLOAD_TOKEN_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=5242880

# 可选：H5 关闭窗口（须配置可信域名）
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_CORP_SECRET=
